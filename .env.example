# Copy this file to `.env` and fill in your values. `.env` is never committed.

# gemini | ollama | fake (fake works offline, without any key)
LLM_PROVIDER=gemini

# Free key: https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# Only if LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
# SQLite database file (created automatically)
DATABASE_PATH=tickets.db